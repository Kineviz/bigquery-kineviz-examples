# Credentials — never commit. Enforced by .github/workflows/secrets.yml
.env
.gcp/
*key.json
*credentials*.json
service-account*.json

# Local docs preview (tools/preview.sh)
.preview/

# Demo scratch. Note the leading **: a pattern with a mid-string slash is
# anchored to this file's directory, so plain `data/generated/` never matched
# demos/<slug>/data/generated/. All of this is regenerated by `gxr up`.
**/data/generated/
**/.verified_rows
*.log

# sec-filings clones the upstream pipeline here at setup time — a 248 MB nested
# git repo with its own .venv. Never commit it.
demos/*/.upstream/

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Python
__pycache__/
*.pyc
.venv/
venv/
