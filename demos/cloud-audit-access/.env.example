# Copy to .env and fill in GCP_PROJECT. .env is gitignored — never commit it.

GCP_PROJECT=your-project-id
BQ_LOCATION=US
BQ_DATASET=kineviz_audit_demo
BQ_GRAPH=AuditGraph

# Synthetic log volume. The generator is seeded, so the same numbers always
# produce the same graph — including the escalation paths the queries find.
AUDIT_DAYS=14
AUDIT_PRINCIPALS=60
AUDIT_EVENTS=6000
AUDIT_SEED=20260813

# Hard ceiling on every query, in bytes (2 GB). The data is a few MB, so hitting
# this means something is wrong with the query, not the data.
MAX_BYTES_BILLED=2000000000
