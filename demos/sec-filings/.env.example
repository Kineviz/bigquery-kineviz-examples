# Copy to .env and fill in. .env is gitignored — never commit it.

GCP_PROJECT=your-project-id
BQ_LOCATION=US
BQ_DATASET=kineviz_sec_demo
BQ_GRAPH=SecGraph

# GCS bucket for staging extracted JSON. Must already exist and be writable.
# The demo writes under a kineviz-sec-demo/ prefix and teardown removes only that.
GCS_BUCKET=your-bucket-name

# WHICH COMPANIES TO PROCESS — this is the cost dial.
#
# Gemini extraction dominates the bill and scales linearly with ticker count.
# Three companies is enough to see the graph. The full Fortune 500 is roughly
# 170x this, so change it deliberately.
SEC_TICKERS=AAPL,MSFT,NVDA

# Gemini model used for extraction inside BigQuery.
GEMINI_MODEL=gemini-2.5-pro

# Hard ceiling on every query this demo runs directly (2 GB). Note it does NOT
# bound the upstream pipeline's own queries — SEC_TICKERS is what bounds those.
MAX_BYTES_BILLED=2000000000
