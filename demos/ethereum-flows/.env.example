# Copy to .env and fill in GCP_PROJECT. .env is gitignored — never commit it.

GCP_PROJECT=your-project-id
BQ_LOCATION=US
BQ_DATASET=kineviz_eth_demo
BQ_GRAPH=EthGraph

# Which single day of Ethereum history to load. A fixed date keeps the demo
# reproducible — everyone who runs it sees the same graph.
# One day is roughly 1.2M transactions.
ETH_DATE=2024-01-15

# How many addresses to keep, ranked by transfer volume that day. This is the
# main dial for cost and graph size. 1500 gives a graph you can actually read.
TOP_N_ADDRESSES=1500

# Ignore dust. Transfers below this many ETH are excluded, which removes a long
# tail of spam and makes the graph legible.
MIN_ETH=0.01

# Hard ceiling on every query, in bytes (30 GB). Never raise this to make a
# query pass — lower ETH_DATE's scope or TOP_N_ADDRESSES instead.
MAX_BYTES_BILLED=30000000000
