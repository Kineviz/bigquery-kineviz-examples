# Copy to .env and fill in GCP_PROJECT. .env is gitignored — never commit it.

GCP_PROJECT=your-project-id
BQ_LOCATION=US
BQ_DATASET=kineviz_deps_demo
BQ_GRAPH=DepsGraph

# Which deps.dev ecosystem.
DEPS_SYSTEM=NPM

# Which weekly snapshot to read. deps.dev is partitioned by day and snapshots
# land weekly, so this MUST be a real snapshot date or you get an empty graph.
# preflight checks it against INFORMATION_SCHEMA.PARTITIONS before spending.
DEPS_SNAPSHOT=2026-08-10

# THE COST DIAL. Dependencies is 105 TB clustered by (System, Name, Version),
# so naming the packages you care about is what keeps this demo at ~$0.03.
# Aggregating to find "the top N packages" instead costs ~$2.50 however small N
# is, because it has to read the whole snapshot.
DEPS_SEEDS=react,vue,express,lodash,axios,webpack,typescript,eslint,jest,next,vite,rollup

# How deep to follow transitive dependencies. 2 is plenty to see the shape.
DEPS_MAX_DEPTH=2

# How many packages to look up backing repos for. PackageVersionToProject is
# 2.4 TB clustered by name, so a short list stays cheap; passing every
# dependency stops the pruning and costs more than everything else combined.
DEPS_PROJECT_LOOKUP_LIMIT=150

# Hard ceiling on every query, in bytes (8 GB). Never raise this to make a query
# pass — shorten DEPS_SEEDS or lower DEPS_MAX_DEPTH instead.
MAX_BYTES_BILLED=8000000000
