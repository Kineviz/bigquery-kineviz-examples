# Copy to .env and fill in GCP_PROJECT. .env is gitignored — never commit it.

# Google Cloud project the demo creates its dataset in. Billing must be enabled.
GCP_PROJECT=your-project-id

# Location for the demo dataset. Must match the region you enter in Kineviz.
BQ_LOCATION=US

# Dataset this demo creates. Teardown deletes exactly this and nothing else.
BQ_DATASET=kineviz_deps_demo

# Property graph name, used in every query and in the Kineviz connect dialog.
BQ_GRAPH=DepsGraph

# Which deps.dev ecosystem to materialize. One at a time keeps cost near zero.
DEPS_SYSTEM=NPM

# How many packages to include, by dependent count. 2000 is plenty to explore.
TOP_N_PACKAGES=2000

# Hard ceiling on every query, in bytes. Never raise this to make a query pass —
# if a query exceeds it, that is a finding worth reporting.
MAX_BYTES_BILLED=2000000000
